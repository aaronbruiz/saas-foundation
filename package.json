{
  "name": "saas-foundation",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter app dev",
    "build": "pnpm --filter app build",
    "deploy": "pnpm --filter app run deploy",
    "test": "pnpm -r --if-present test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @saas-foundation/db db:generate",
    "db:migrate": "pnpm --filter @saas-foundation/db db:migrate",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel typecheck",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm plans:check",
    "plans:export": "node apps/app/scripts/export-plans.ts",
    "plans:check": "node apps/app/scripts/export-plans.ts --check",
    "auth:generate": "pnpm --filter @saas-foundation/auth auth:generate",
    "test:e2e": "pnpm --filter app test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "neon": "8.3.5",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
