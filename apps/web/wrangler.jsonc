// Worker config. Changes only via PR; new bindings need an ADR (AGENTS.md invariants 13-14).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saas-foundation",
  // ADR-0017: the production account (it holds the production zone). Pinned so wrangler never
  // targets another account.
  "account_id": "17eeb935de129532d2bdea10a15d72ff",
  // Production is served only on the custom domain (Cloudflare creates DNS + certificate on deploy).
  // No production workers.dev URL: it would bypass the zone's WAF rule (ADR-0014).
  "workers_dev": false,
  // No per-version preview URLs on the production Worker either (they'd serve production bindings
  // outside the WAF). PR previews run on the separate Worker `saas-foundation-preview` (ADR-0013);
  // CI flips this to true only in its build copy for that Worker.
  "preview_urls": false,
  "routes": [{ "pattern": "app.aaronlabr.dev", "custom_domain": true }],
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  // Run SSR and server functions next to Neon (aws-us-east-1); static assets are still served at the edge.
  "placement": { "region": "aws:us-east-1" },
  // ADR-0015: Workers Logs (console output + one invocation log per request), all requests sampled.
  // Query strings are stripped from logged URLs (tokens, emails); path segments are not.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": true },
    // ADR-0015: Workers Issues groups uncaught exceptions, 5xx responses and error-level logs.
    // Alerting (an automation and its destination) is configured in the dashboard, not here.
    "issues": { "enabled": true },
  },
  "upload_source_maps": true,
  // ADR-0003/0004: the only DB binding. Remote: Hyperdrive config `saas-foundation-prod` in the
  // account above (caching disabled) → Neon project flat-cherry-23373668, branch `main`, direct host.
  // Locally, wrangler connects directly to docker-compose Postgres (no pooling/caching).
  "hyperdrive": [
    {
      "binding": "DB",
      "id": "e788b06678f1450eb89f8b52384ab3a3",
      "localConnectionString": "postgres://app:app@localhost:5432/app",
    },
  ],
  // ADR-0016, ADR-0024: transactional email through Cloudflare Email Service (domain mail.aaronlabr.dev).
  // Restricted to the one sender address; EMAIL_DELIVERY=cloudflare and EMAIL_FROM are production
  // secrets. Previews never get this binding: scripts/preview/prepare-config.mjs removes it.
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["no-reply@mail.aaronlabr.dev"] }],
  // Fail closed (ADR-0011, ADR-0021): previews must never fall back to the production DB binding
  // above. The built artifact must keep this sentinel; after the build, the trusted deploy job
  // (scripts/preview/prepare-config.mjs) points the DB binding at the PR's own Hyperdrive config.
  // Any preview deployed without that patch fails, because the sentinel id doesn't exist.
  "previews": {
    "hyperdrive": [{ "binding": "DB", "id": "00000000000000000000000000000000" }],
  },
}
