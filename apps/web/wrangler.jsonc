// Worker config. Changes only via PR; new bindings need an ADR (AGENTS.md invariants 13-14).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saas-foundation",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  // Run SSR and server functions next to Neon (aws-us-east-1); static assets are still served at the edge.
  "placement": { "region": "aws:us-east-1" },
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // ADR-0003/0004: the only DB binding. Remote: Hyperdrive config `saas-foundation-prod`
  // (caching disabled) → Neon project flat-cherry-23373668, branch `main`, direct host.
  // Locally, wrangler connects directly to docker-compose Postgres (no pooling/caching).
  "hyperdrive": [
    {
      "binding": "DB",
      "id": "29b70e89b57945e1875c0a030b377243",
      "localConnectionString": "postgres://app:app@localhost:5432/app",
    },
  ],
  // Fail closed (ADR-0011): previews must never fall back to the production DB binding above.
  // CI replaces this sentinel with the PR's own Hyperdrive config id before building. Any preview
  // deployed without that injection fails, because the sentinel id doesn't exist.
  "previews": {
    "hyperdrive": [{ "binding": "DB", "id": "00000000000000000000000000000000" }],
  },
}
