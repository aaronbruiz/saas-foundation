{
  "name": "web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000 --strictPort",
    "build": "vite build",
    "preview": "pnpm build && vite preview",
    "deploy": "node ../../scripts/check-secrets.mjs --deployed && pnpm build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "generate-routes": "tsr generate",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@polar-sh/sdk": "1.0.2",
    "@saas-foundation/auth": "workspace:*",
    "@saas-foundation/contracts": "workspace:*",
    "@saas-foundation/db": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-router": "^1.170.42",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.168.61",
    "better-auth": "^1.7.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@playwright/test": "^1.64.0",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/router-cli": "^1.167.41",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  }
}
