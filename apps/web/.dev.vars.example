# Copy to .dev.vars (git-ignored) for `pnpm dev`. Generate a secret: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-plus-random-bytes
BETTER_AUTH_URL=http://localhost:3000
# ADR-0014 data gate: local dev signs up anyone. Unset = closed (production default).
SIGNUP_MODE=open
# ADR-0016: print auth emails (links included) to the dev console. Refused outside localhost.
EMAIL_DELIVERY=console
# ADR-0022: billing stays off (503) unless BILLING_PROVIDER=polar. Set it only together with the
# token (without it, owner changes are refused). Polar sandbox values only, never production.
# BILLING_PROVIDER=polar
# POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET=
# POLAR_SERVER=sandbox
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
