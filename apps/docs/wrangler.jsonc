// ADR-0028: the docs Worker serves static assets only: no `main`, no bindings, no vars, no secrets,
// no environments, no previews block (scripts/check-bindings.mjs enforces it). Previews deploy to
// `saas-foundation-docs-preview` from CI with this file and `--name`. The Custom Domain is attached
// once by the owner with a manual `wrangler deploy` (per-Worker tokens can't manage domains).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saas-foundation-docs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "docs.aaronlabr.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
}
