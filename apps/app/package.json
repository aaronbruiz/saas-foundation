{
  "name": "app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000 --strictPort",
    "build": "vite build",
    "preview": "pnpm build && vite preview",
    "deploy": "node ../../scripts/check-secrets.mjs --deployed && pnpm build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --env-file .dev.vars.example",
    "types:check": "wrangler types --env-file .dev.vars.example --check",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@polar-sh/sdk": "1.0.2",
    "@saas-foundation/auth": "workspace:*",
    "@saas-foundation/contracts": "workspace:*",
    "@saas-foundation/db": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-start": "^1.169.3",
    "better-auth": "^1.7.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  }
}
