{
  "name": "app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000 --strictPort",
    "build": "vite build",
    "preview": "pnpm build && vite preview",
    "deploy": "node ../../scripts/check-secrets.mjs --deployed && pnpm build && wrangler deploy",
    "typecheck": "pnpm cf-typegen && tsc --noEmit",
    "cf-typegen": "wrangler types --env-file .dev.vars.example",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "node ../../scripts/test-visual.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@polar-sh/sdk": "1.0.2",
    "@saas-foundation/auth": "workspace:*",
    "@saas-foundation/brand": "workspace:*",
    "@saas-foundation/contracts": "workspace:*",
    "@saas-foundation/db": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "better-auth": "^1.7.17",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/vitest-plugin": "^1.5.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.156.2"
  }
}
