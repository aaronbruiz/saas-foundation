{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm lint)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm test:e2e)",
      "Bash(pnpm build)",
      "Bash(pnpm db:up)",
      "Bash(pnpm db:generate)",
      "Bash(pnpm --filter web cf-typegen)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git push *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh workflow *)",
      "Bash(gh pr review *)"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "Bash(pnpm db:migrate *)",
      "Bash(pnpm deploy *)",
      "Bash(wrangler deploy *)",
      "Bash(pnpm exec wrangler deploy *)",
      "Bash(scripts/preview/*)",
      "Bash(scripts/backup/*)"
    ],
    "deny": [
      "Read(./.dev.vars)",
      "Read(./**/.dev.vars)",
      "Read(./**/.dev.vars.*)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Edit(./packages/db/src/schema/auth.ts)",
      "Edit(./**/routeTree.gen.ts)",
      "Edit(./**/worker-configuration.d.ts)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-poll-loops.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
