{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm lint)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm test:e2e)",
      "Bash(pnpm build)",
      "Bash(pnpm db:up)",
      "Bash(pnpm db:generate)",
      "Bash(pnpm --filter app cf-typegen)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh workflow list *)",
      "Bash(gh workflow view *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git fetch *)",
      "Bash(git rev-parse *)",
      "Bash(git push *)",
      "Bash(scripts/test-lock.sh *)",
      "Bash(pnpm install --frozen-lockfile*)"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "Bash(pnpm db:migrate *)",
      "Bash(pnpm deploy *)",
      "Bash(wrangler deploy *)",
      "Bash(pnpm exec wrangler deploy *)",
      "Bash(scripts/preview/*)",
      "Bash(scripts/backup/*)",
      "Bash(gh workflow run *)",
      "Bash(gh run rerun *)",
      "Bash(gh api */approve*)",
      "Bash(gh api */pending_deployments*)",
      "Bash(gh api */rerun*)",
      "Bash(scripts/release/*)",
      "Bash(./scripts/release/*)",
      "Bash(scripts/sites/deploy.sh*)",
      "Bash(scripts/sites/rollback.sh*)",
      "Bash(./scripts/sites/deploy.sh*)",
      "Bash(./scripts/sites/rollback.sh*)",
      "Bash(*wrangler versions deploy*)",
      "Bash(*wrangler rollback*)",
      "Bash(*wrangler deploy)",
      "Bash(*wrangler deploy *)",
      "Bash(pnpm run deploy)",
      "Bash(pnpm run deploy *)",
      "Bash(pnpm --filter * run deploy)",
      "Bash(pnpm --filter * run deploy *)"
    ],
    "deny": [
      "Read(./.dev.vars)",
      "Read(./**/.dev.vars)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.production)",
      "Read(./**/.env.development)",
      "Read(./**/.env.test)",
      "Edit(./packages/db/src/schema/auth.ts)",
      "Edit(./**/routeTree.gen.ts)",
      "Edit(./**/worker-configuration.d.ts)",
      "Bash(git push *--force*)",
      "Bash(git push *-f *)",
      "Bash(git push *-f)",
      "Bash(git push *+*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push)",
      "Bash(git push origin)",
      "Bash(git push -u origin)",
      "Bash(git push --set-upstream origin)",
      "Bash(git push * HEAD)",
      "Bash(git push --all*)",
      "Bash(git push --mirror*)",
      "Bash(*push*:main*)",
      "Bash(*push*HEAD:main*)",
      "Bash(*push* main)",
      "Bash(*push* main *)",
      "Bash(git -C * push *)",
      "Bash(git -c * push *)",
      "Bash(gh api */merge*)",
      "Bash(gh api */dispatches*)",
      "Bash(gh api graphql *mergePullRequest*)",
      "Bash(gh api graphql *enablePullRequestAutoMerge*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-poll-loops.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  }
}
