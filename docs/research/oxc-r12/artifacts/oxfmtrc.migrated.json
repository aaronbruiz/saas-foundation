{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "sortPackageJson": false,
  "astro": {},
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "**/routeTree.gen.ts",
    "**/worker-configuration.d.ts",
    "**/dist",
    "**/.wrangler",
    "**/.tanstack",
    "**/.astro",
    "**/drizzle/meta",
    "**/src/schema/auth.ts",
    "/apps/app/CHANGELOG.md"
  ]
}
